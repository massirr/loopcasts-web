@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "No access";
}

<div class="narrow">
    <partial name="_AccountLogo" />
    <section class="card">
        <h1>This page is for LoopCasts staff</h1>
        <p>You are logged in, but your account can't open it. Looking for your courses and invoices?</p>
        <a class="btn-sign btn-wide" asp-area="" asp-page="/My">Go to My LoopCasts</a>
    </section>
</div>
