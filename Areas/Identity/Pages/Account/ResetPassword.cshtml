@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Choose your password";
}

<div class="narrow">
    <partial name="_AccountLogo" />
    <section class="card">
        <h1>Choose your password</h1>
        <p class="muted">At least 6 characters, with a capital, a small letter, a number and a symbol.</p>
        <form method="post" class="form" novalidate>
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>
            <input asp-for="Input.Code" type="hidden" />
            <div class="field">
                <label asp-for="Input.Email">E-mail</label>
                <input asp-for="Input.Email" autocomplete="username" />
                <span asp-validation-for="Input.Email"></span>
            </div>
            <div class="field">
                <label asp-for="Input.Password">New password</label>
                <input asp-for="Input.Password" autocomplete="new-password" />
                <span asp-validation-for="Input.Password"></span>
            </div>
            <div class="field">
                <label asp-for="Input.ConfirmPassword">Type it again</label>
                <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword"></span>
            </div>
            <button type="submit" class="btn-sign btn-wide">Save password</button>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="/Pages/Shared/_ValidationScriptsPartial.cshtml" />
}
