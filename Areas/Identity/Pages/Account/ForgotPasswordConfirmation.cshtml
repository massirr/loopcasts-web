@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Check your mailbox";
}

<div class="narrow">
    <partial name="_AccountLogo" />
    <section class="card">
        <h1>Check your mailbox</h1>
        <p>If we know that address, a link to choose a new password is on its way. It works for 24 hours.</p>
        <p class="small"><a asp-page="./Login">Back to log in</a></p>
    </section>
</div>
