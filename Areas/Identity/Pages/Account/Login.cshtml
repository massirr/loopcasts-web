@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="narrow">
    <partial name="_AccountLogo" />
    <section class="card">
        <h1>Log in</h1>
        <p class="muted">Use the e-mail you ordered with.</p>
        @if (!string.IsNullOrEmpty(Model.ErrorMessage)) { <p class="flash flash-error" role="alert"><span>@Model.ErrorMessage</span></p> }
        <form id="account" method="post" class="form" novalidate>
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>
            <div class="field">
                <label asp-for="Input.Email">E-mail</label>
                <input asp-for="Input.Email" autocomplete="username" />
                <span asp-validation-for="Input.Email"></span>
            </div>
            <div class="field">
                <label asp-for="Input.Password">Password</label>
                <input asp-for="Input.Password" autocomplete="current-password" />
                <span asp-validation-for="Input.Password"></span>
            </div>
            <label class="check"><input asp-for="Input.RememberMe" /> Keep me logged in</label>
            <button id="login-submit" type="submit" class="btn-sign btn-wide">Log in</button>
        </form>
        <p class="small"><a asp-page="./ForgotPassword">Forgot your password?</a></p>
    </section>
</div>

@section Scripts {
    <partial name="/Pages/Shared/_ValidationScriptsPartial.cshtml" />
}
