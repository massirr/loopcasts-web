@page
@model SetPasswordModel
@{
    ViewData["Title"] = "Password";
}
<partial name="_Flash" model="Model.StatusMessage" />
<section class="card">
    <h2>Choose a password</h2>
    <p class="muted">Your login has no password yet.</p>
    <form method="post" class="form" novalidate>
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>
        <div class="field">
            <label asp-for="Input.NewPassword">Password <span class="field-hint">at least 6 characters, with a capital, a small letter, a number and a symbol</span></label>
            <input asp-for="Input.NewPassword" autocomplete="new-password" />
            <span asp-validation-for="Input.NewPassword"></span>
        </div>
        <div class="field">
            <label asp-for="Input.ConfirmPassword">Type it again</label>
            <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword"></span>
        </div>
        <div><button type="submit" class="btn-ink" data-busy-text="Saving…">Save password</button></div>
    </form>
</section>

@section Scripts {
    <partial name="/Pages/Shared/_ValidationScriptsPartial.cshtml" />
}
