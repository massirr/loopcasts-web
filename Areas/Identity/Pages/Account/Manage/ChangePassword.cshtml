@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Password";
}
<partial name="_Flash" model="Model.StatusMessage" />
<section class="card">
    <h2>Password</h2>
    <form method="post" class="form" novalidate>
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>
        <div class="field">
            <label asp-for="Input.OldPassword">Current password</label>
            <input asp-for="Input.OldPassword" autocomplete="current-password" />
            <span asp-validation-for="Input.OldPassword"></span>
        </div>
        <div class="field">
            <label asp-for="Input.NewPassword">New password <span class="field-hint">at least 6 characters, with a capital, a small letter, a number and a symbol</span></label>
            <input asp-for="Input.NewPassword" autocomplete="new-password" />
            <span asp-validation-for="Input.NewPassword"></span>
        </div>
        <div class="field">
            <label asp-for="Input.ConfirmPassword">Type it again</label>
            <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword"></span>
        </div>
        <div><button type="submit" class="btn-ink" data-busy-text="Saving…">Change password</button></div>
    </form>
    <p class="small"><a asp-area="Identity" asp-page="/Account/ForgotPassword">Forgot your current password?</a></p>
</section>

@section Scripts {
    <partial name="/Pages/Shared/_ValidationScriptsPartial.cshtml" />
}
