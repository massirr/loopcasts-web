@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<div class="narrow">
    <partial name="_AccountLogo" />
    <section class="card">
        <h1>Forgot your password?</h1>
        <p class="muted">Enter your e-mail. We send you a link to choose a new password.</p>
        <form method="post" class="form" novalidate>
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>
            <div class="field">
                <label asp-for="Input.Email">E-mail</label>
                <input asp-for="Input.Email" autocomplete="username" />
                <span asp-validation-for="Input.Email"></span>
            </div>
            <button type="submit" class="btn-sign btn-wide">Send me a link</button>
        </form>
        <p class="small"><a asp-page="./Login">Back to log in</a></p>
    </section>
</div>

@section Scripts {
    <partial name="/Pages/Shared/_ValidationScriptsPartial.cshtml" />
}
