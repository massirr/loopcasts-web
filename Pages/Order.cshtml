@page
@model OrderModel
@{
    ViewData["Title"] = "Order";
}

<h1 class="mb-1">Order: @Model.SelectedPlan!.Name</h1>
<p class="text-muted mb-4">@($"€{Model.SelectedPlan.Price:0}") excl. VAT · @Model.SelectedPlan.Detail</p>

<form method="post" class="row g-3" style="max-width:720px">
    <input type="hidden" asp-for="Order.PlanCode" />

    <div class="col-md-6">
        <label asp-for="Order.Name" class="form-label"></label>
        <input asp-for="Order.Name" class="form-control" />
        <span asp-validation-for="Order.Name" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Order.Email" class="form-label"></label>
        <input asp-for="Order.Email" class="form-control" />
        <span asp-validation-for="Order.Email" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Order.Country" class="form-label"></label>
        <select asp-for="Order.Country" asp-items="Model.CountryOptions" class="form-select">
            <option value="">Choose your country…</option>
        </select>
        <span asp-validation-for="Order.Country" class="text-danger small"></span>
    </div>

    @if (Model.SelectedPlan.CompanyOnly)
    {
        @* Team licence: always a company, so no checkbox *@
        <input type="hidden" asp-for="Order.IsCompany" value="true" />
        <div class="col-12"><p class="small text-muted mb-0">The team licence is for companies, so we need your company details.</p></div>
    }
    else
    {
        <div class="col-12">
            <div class="form-check">
                <input asp-for="Order.IsCompany" class="form-check-input" />
                <label asp-for="Order.IsCompany" class="form-check-label"></label>
            </div>
        </div>
    }

    @* Company fields: hidden for individuals, shown when the box is checked (or always for the team licence) *@
    <div id="company-fields" class="col-12" hidden="@(!Model.Order.IsCompany)">
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Order.Company" class="form-label"></label>
                <input asp-for="Order.Company" class="form-control" />
                <span asp-validation-for="Order.Company" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Order.VatNumber" class="form-label"></label>
                <input asp-for="Order.VatNumber" class="form-control" placeholder="BE0123.456.789" />
                <span asp-validation-for="Order.VatNumber" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="Order.Address" class="form-label"></label>
                <input asp-for="Order.Address" class="form-control" />
                <span asp-validation-for="Order.Address" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary">Place order</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Show the company fields only when "I'm ordering for a company" is checked.
        // (Only the look changes here; the server still checks the rule in OnPost.)
        const box = document.getElementById("Order_IsCompany");
        const fields = document.getElementById("company-fields");
        if (box && box.type === "checkbox") {
            box.addEventListener("change", () => { fields.hidden = !box.checked; });
        }
    </script>
}