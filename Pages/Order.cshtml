@page
@model OrderModel
@{
    ViewData["Title"] = "Order";
    var plan = Model.SelectedPlan!;
}

<div class="page">
    <header class="page-head">
        <h1>Your order</h1>
        <p>We need a few details for your invoice and your login. Takes a minute.</p>
    </header>

    <div class="order-layout">
        <form method="post" class="form" novalidate>
            <input type="hidden" asp-for="Order.PlanCode" />
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="field">
                <label asp-for="Order.Name">Name</label>
                <input asp-for="Order.Name" autocomplete="name" />
                <span asp-validation-for="Order.Name"></span>
            </div>

            <div class="field">
                <label asp-for="Order.Email">E-mail <span class="field-hint">your login and where the invoice goes</span></label>
                <input asp-for="Order.Email" type="email" autocomplete="email" />
                <span asp-validation-for="Order.Email"></span>
            </div>

            <div class="field">
                <label asp-for="Order.Country">Country</label>
                <select asp-for="Order.Country" asp-items="Model.CountryOptions" autocomplete="country">
                    <option value="">Choose your country…</option>
                </select>
                <span asp-validation-for="Order.Country"></span>
            </div>

            @if (plan.CompanyOnly)
            {
                @* Team licence: always a company, so no checkbox *@
                <input type="hidden" asp-for="Order.IsCompany" value="true" />
                <p class="muted small">The team licence is for companies, so we need your company details.</p>
            }
            else
            {
                <label class="check">
                    <input asp-for="Order.IsCompany" />
                    I'm ordering for a company
                </label>
            }

            @* Company fields: hidden for individuals, shown when the box is checked (or always for the team licence) *@
            <fieldset id="company-fields" class="form company" hidden="@(!Model.Order.IsCompany)">
                <legend class="visually-hidden">Company details</legend>
                <div class="field">
                    <label asp-for="Order.Company">Company name</label>
                    <input asp-for="Order.Company" autocomplete="organization" />
                    <span asp-validation-for="Order.Company"></span>
                </div>
                <div class="field">
                    <label asp-for="Order.VatNumber">VAT number</label>
                    <input asp-for="Order.VatNumber" placeholder="BE0123456789" />
                    <span asp-validation-for="Order.VatNumber"></span>
                </div>
                <div class="field">
                    <label asp-for="Order.Address">Address <span class="field-hint">street, number, postcode, city</span></label>
                    <input asp-for="Order.Address" autocomplete="street-address" />
                    <span asp-validation-for="Order.Address"></span>
                </div>
            </fieldset>

            <div><button type="submit" class="btn-sign">Continue to payment</button></div>
        </form>

        <aside class="card summary" aria-label="Your plan">
            <h2 class="h-small">@plan.Name</h2>
            <p class="price num">@($"€{plan.Price:0}")</p>
            <p class="muted small">excl. VAT · @plan.Detail</p>
            <p class="small">VAT depends on your country and whether you order as a company. You see the total before you pay.</p>
            <a class="small" asp-page="/Pricing">Choose another plan</a>
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Show the company fields only when "I'm ordering for a company" is checked.
        // (Only the look changes here; the server still checks the rule in OnPost.)
        const box = document.getElementById("Order_IsCompany");
        const fields = document.getElementById("company-fields");
        if (box && box.type === "checkbox") {
            box.addEventListener("change", () => { fields.hidden = !box.checked; });
        }
    </script>
}
