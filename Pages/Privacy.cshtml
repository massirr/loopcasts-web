@page
@model PrivacyModel
@inject IConfiguration Config
@{
    ViewData["Title"] = "Privacy";
}

<div class="page">
    <header class="page-head">
        <h1>Privacy</h1>
        <p>Short version: we only use your details to deliver what you ordered.</p>
    </header>
    <section class="card prose">
        <p>When you order, we keep your name, e-mail, country and, for companies, the company name, VAT number and address. We need them for your login, your invoice and the VAT rules.</p>
        <p>Payments are handled by our payment provider; we never see your card or bank details.</p>
        <p>You can download your data or delete your account yourself, under Account settings, Your data. Invoices stay in our books, as the law requires.</p>
        <p>Something else you want to see or change? Mail @Config["Seller:SupportEmail"] and we'll help you.</p>
    </section>
</div>
