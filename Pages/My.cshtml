@page
@model MyModel
@{
    ViewData["Title"] = "My LoopCasts";
    var today = DateOnly.FromDateTime(DateTime.UtcNow);
}

<div class="page">
    <header class="page-head">
        <h1>My LoopCasts</h1>
        <p class="wrap-any">@Model.Email</p>
    </header>

    @if (Model.Message is not null) { <p class="flash flash-ok" role="status"><span>@Model.Message</span></p> }
    @if (Model.Error is not null) { <p class="flash flash-error" role="alert"><span>@Model.Error</span></p> }
    @if (Model.SetupUrl is not null)
    {
        <div class="flash flash-info stack">
            <label for="setup-url">Send this link to your colleague so they can choose a password. It works for 24 hours and is shown only once.</label>
            <input id="setup-url" readonly value="@Model.SetupUrl" onclick="this.select()" />
        </div>
    }

    <section class="section" aria-labelledby="subs-title">
        <h2 id="subs-title">Your plans</h2>
        @if (Model.Subscriptions.Count == 0)
        {
            <p>No plans yet. <a asp-page="/Pricing">See plans</a> to get started.</p>
        }
        else
        {
            <div class="grid">
                @foreach (var s in Model.Subscriptions)
                {
                    var a = s.Account;
                    var active = a.IsActive && (a.EndsOn is null || a.EndsOn >= today);
                    <article class="card">
                        <h3>@s.PlanName</h3>
                        <p class="status @(active ? "status-ok" : "status-off")">@(active ? "Active" : "Ended")</p>
                        <dl class="facts">
                            <dt>Since</dt><dd>@a.StartsOn.ToString("dd/MM/yyyy")</dd>
                            <dt>Access until</dt><dd>@(a.EndsOn?.ToString("dd/MM/yyyy") ?? "lifetime")</dd>
                        </dl>
                    </article>
                }
            </div>
        }
    </section>

    @foreach (var l in Model.Licences)
    {
        <section class="section" aria-labelledby="team-@l.Order.Id">
            <div class="section-head">
                <h2 id="team-@l.Order.Id">Your team</h2>
                <p class="muted num">@l.Used of @l.Seats seats used · team licence, order @l.Order.Id</p>
            </div>
            <div class="table-scroll">
                <table class="table">
                    <thead><tr><th>Who</th><th class="end"><span class="visually-hidden">Actions</span></th></tr></thead>
                    <tbody>
                        @foreach (var a in l.Accounts.Where(a => a.IsActive))
                        {
                            var mine = string.Equals(a.Email, l.Order.Email, StringComparison.OrdinalIgnoreCase);
                            <tr>
                                <td class="wrap-any">@a.Email @if (mine) { <span class="muted">(you)</span> }</td>
                                <td class="end">
                                    @if (!mine)
                                    {
                                        <form method="post" asp-page-handler="RemoveSeat" asp-route-orderId="@l.Order.Id" asp-route-accountId="@a.Id">
                                            <button class="btn-quiet btn-small btn-danger-quiet" aria-label="Remove @a.Email">Remove</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (l.Used < l.Seats)
            {
                <form method="post" asp-page-handler="AddSeat" asp-route-orderId="@l.Order.Id" class="add-seat">
                    <label for="seat-@l.Order.Id" class="visually-hidden">Colleague's e-mail</label>
                    <input id="seat-@l.Order.Id" name="email" type="email" required placeholder="colleague@company.com" />
                    <button class="btn-ink">Add colleague</button>
                </form>
            }
        </section>
    }

    <section class="section" aria-labelledby="inv-title">
        <h2 id="inv-title">Invoices</h2>
        @if (Model.Invoices.Count == 0)
        {
            <p class="muted">No invoices yet. They appear here as soon as you pay.</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="table">
                    <thead><tr><th>Number</th><th>Date</th><th class="end">Total</th><th class="end"><span class="visually-hidden">Open</span></th></tr></thead>
                    <tbody>
                        @foreach (var i in Model.Invoices)
                        {
                            <tr>
                                <td>@i.Number</td>
                                <td>@i.IssuedOn.ToString("dd/MM/yyyy")</td>
                                <td class="end">@($"€{i.Total:0.00}")</td>
                                <td class="end"><a asp-page="/Invoice" asp-route-number="@i.Number" aria-label="View or print invoice @i.Number">View / print</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
