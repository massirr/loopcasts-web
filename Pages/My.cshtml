@page
@model MyModel
@{
    ViewData["Title"] = "My LoopCasts";
    var today = DateOnly.FromDateTime(DateTime.UtcNow);
}

<h1 class="mb-1">My LoopCasts</h1>
<p class="text-muted mb-4">@Model.Email</p>

@if (Model.Message is not null) { <div class="alert alert-success">@Model.Message</div> }
@if (Model.Error is not null) { <div class="alert alert-danger">@Model.Error</div> }
@if (Model.SetupUrl is not null)
{
    <div class="alert alert-info">
        Send this link to your colleague so they can choose a password (valid 24 hours, shown only once):
        <input class="form-control form-control-sm mt-2" readonly value="@Model.SetupUrl" onclick="this.select()" />
    </div>
}

@foreach (var l in Model.Licences)
{
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h5">Team licence · order #@l.Order.Id <span class="badge text-bg-light">@l.Used / @l.Seats seats</span></h2>
            <table class="table table-sm align-middle mb-3">
                @foreach (var a in l.Accounts.Where(a => a.IsActive))
                {
                    var mine = string.Equals(a.Email, l.Order.Email, StringComparison.OrdinalIgnoreCase);
                    <tr>
                        <td>@a.Email @if (mine) { <span class="badge text-bg-secondary">you</span> }</td>
                        <td class="text-end">
                            @if (!mine)
                            {
                                <form method="post" asp-page-handler="RemoveSeat" asp-route-orderId="@l.Order.Id" asp-route-accountId="@a.Id">
                                    <button class="btn btn-sm btn-outline-danger">Remove</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </table>
            @if (l.Used < l.Seats)
            {
                <form method="post" asp-page-handler="AddSeat" asp-route-orderId="@l.Order.Id" class="d-flex gap-2" style="max-width:420px">
                    <input name="email" type="email" required class="form-control form-control-sm" placeholder="colleague@company.com" />
                    <button class="btn btn-sm btn-primary text-nowrap">Add colleague</button>
                </form>
            }
        </div>
    </div>
}

<h2 class="h4">Subscriptions</h2>
@if (Model.Subscriptions.Count == 0)
{
    <p>No subscriptions yet. See <a asp-page="/Pricing">Pricing</a>.</p>
}
else
{
    <div class="table-responsive mb-5">
        <table class="table align-middle">
            <thead><tr><th>Product</th><th>Start</th><th>Access until</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var s in Model.Subscriptions)
                {
                    var a = s.Account;
                    <tr>
                        <td>@s.PlanName</td>
                        <td>@a.StartsOn.ToString("dd/MM/yyyy")</td>
                        <td>@(a.EndsOn?.ToString("dd/MM/yyyy") ?? "lifetime")</td>
                        <td>
                            @if (a.IsActive && (a.EndsOn is null || a.EndsOn >= today)) { <span class="badge text-bg-success">active</span> }
                            else { <span class="badge text-bg-secondary">ended</span> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2 class="h4">Invoices</h2>
@if (Model.Invoices.Count == 0)
{
    <p>No invoices.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Number</th><th>Date</th><th class="text-end">Total</th><th></th></tr></thead>
            <tbody>
                @foreach (var i in Model.Invoices)
                {
                    <tr>
                        <td>@i.Number</td>
                        <td>@i.IssuedOn.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">@($"€{i.Total:0.00}")</td>
                        <td class="text-end"><a asp-page="/Invoice" asp-route-number="@i.Number">View / print</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
