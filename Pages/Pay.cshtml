@page
@model PayModel
@{
    ViewData["Title"] = "Payment";
    var o = Model.Order!;
}

<div class="narrow">
    @if (!Model.UsesMollie)
    {
        <p class="flash flash-info"><span><strong>Test payment.</strong> This page stands in for the payment provider (no Mollie key set). No real money moves.</span></p>
    }
    @if (Model.Error is not null)
    {
        <p class="flash flash-error" role="alert"><span>@Model.Error</span></p>
    }

    <section class="card">
        <p class="muted small">LoopCasts BV · order @o.Id</p>
        <h1>@(Model.Plan?.Name ?? o.PlanCode)</h1>
        <p class="pay-total num">@($"€{Model.Total:0.00}")</p>
        <p class="muted small wrap-any">@($"€{o.Price:0.00}") excl. VAT · @o.Email</p>

        <form method="post" asp-route-id="@o.Id" asp-route-key="@o.AccessKey">
            <button type="submit" class="btn-sign btn-wide">
                Pay @($"€{Model.Total:0.00}") @(Model.UsesMollie ? "with Mollie" : "(test)")
            </button>
        </form>
    </section>
</div>
