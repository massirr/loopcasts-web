@page
@model PayModel
@{
    ViewData["Title"] = "Payment";
    var o = Model.Order!;
}

<div class="mx-auto" style="max-width:480px">
    <div class="alert alert-warning small">
        <strong>Test payment.</strong> This page simulates the payment provider (e.g. Mollie). No real money is involved.
    </div>

    <div class="card">
        <div class="card-body">
            <p class="text-muted small mb-1">LoopCasts BV · order #@o.Id</p>
            <h1 class="h4">@(Model.Plan?.Name ?? o.PlanCode)</h1>
            <p class="display-6 my-3">@($"€{o.Price:0.00}")</p>
            <p class="small text-muted">excl. VAT · @o.Email</p>

            <form method="post" asp-route-id="@o.Id">
                <button type="submit" class="btn btn-primary w-100">Pay @($"€{o.Price:0.00}") (test)</button>
            </form>
        </div>
    </div>
</div>
