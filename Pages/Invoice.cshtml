@page
@model InvoiceModel
@{
    ViewData["Title"] = $"Invoice {Model.Invoice.Number}";
    var i = Model.Invoice;
    var s = Model.Seller;
}

<div class="invoice-page">
    <div class="row no-print invoice-actions">
        <button class="btn-outline btn-small" type="button" onclick="window.print()">Print or save as PDF</button>
    </div>

    <article class="card invoice">
        <header class="invoice-head">
            <div class="stack">
                <span class="logo-line"><partial name="_Logo" /> <strong>@s["Name"]</strong></span>
                @if (!string.IsNullOrWhiteSpace(s["Address"])) { <span class="muted small pre">@s["Address"]</span> }
                @if (!string.IsNullOrWhiteSpace(s["VatNumber"])) { <span class="muted small">VAT @s["VatNumber"]</span> }
            </div>
            <div class="stack invoice-no">
                <h1>Invoice</h1>
                <span class="num"><strong>@i.Number</strong></span>
                <span class="small num">@i.IssuedOn.ToString("dd/MM/yyyy")</span>
            </div>
        </header>

        <section class="stack" aria-label="Billed to">
            <span class="muted small">Billed to</span>
            <span class="wrap-any">
                @if (i.BillingCompany is not null) { <strong>@i.BillingCompany</strong><br /> }
                @i.BillingName<br />
                @if (i.BillingAddress is not null) { <span class="pre">@i.BillingAddress</span><br /> }
                @(Countries.Find(i.BillingCountry)?.Name ?? i.BillingCountry)
                @if (i.BillingVatNumber is not null) { <br />@($"VAT {i.BillingVatNumber}") }
            </span>
        </section>

        <div class="table-scroll">
            <table class="table">
                <thead><tr><th>Description</th><th class="end">Amount</th></tr></thead>
                <tbody><tr><td>@i.Description</td><td class="end">@($"€{i.AmountExclVat:0.00}")</td></tr></tbody>
                <tfoot>
                    <tr><td class="end">Subtotal excl. VAT</td><td class="end">@($"€{i.AmountExclVat:0.00}")</td></tr>
                    <tr><td class="end">VAT @($"{i.VatRate * 100:0}")%</td><td class="end">@($"€{i.VatAmount:0.00}")</td></tr>
                    <tr class="total"><td class="end">Total</td><td class="end">@($"€{i.Total:0.00}")</td></tr>
                </tfoot>
            </table>
        </div>

        @if (i.ReverseCharge)
        {
            <p class="small"><strong>VAT reverse charged</strong> (art. 196 Directive 2006/112/EC): the customer accounts for the VAT.</p>
        }
        else if (i.VatRate == 0)
        {
            <p class="small">No VAT: customer established outside the EU.</p>
        }
        <p class="small muted">Paid online. Thank you! Questions? Lotte answers at @s["SupportEmail"].</p>
    </article>
</div>
