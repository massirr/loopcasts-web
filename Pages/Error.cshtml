@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="narrow">
    <section class="card">
        <h1>Something went wrong on our side</h1>
        <p>Try again in a minute. If it keeps happening, mail us and mention the code below.</p>
        @if (Model.ShowRequestId)
        {
            <p class="muted small">Code: <span class="num wrap-any">@Model.RequestId</span></p>
        }
        <div><a class="btn-sign" asp-page="/Index">Back to the home page</a></div>
    </section>
</div>
