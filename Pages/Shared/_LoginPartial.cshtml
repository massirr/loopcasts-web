@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@{
    var current = ViewContext.RouteData.Values["page"] as string;
}
@if (SignInManager.IsSignedIn(User))
{
    <a class="nav-link" asp-area="" asp-page="/My" aria-current="@(current == "/My" ? "page" : null)">My LoopCasts</a>
    @if (User.IsInRole("Admin"))
    {
        <a class="nav-link" asp-area="" asp-page="/Admin/Orders" aria-current="@(current?.StartsWith("/Admin/") == true ? "page" : null)">Admin</a>
    }
    <a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index" title="@User.Identity?.Name">Account</a>
    <form class="nav-form" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
        <button type="submit" class="nav-link nav-button">Log out</button>
    </form>
}
else
{
    <a class="btn-outline btn-small" asp-area="Identity" asp-page="/Account/Login">Log in</a>
}
