@using Microsoft.AspNetCore.Identity
@using LoopCastsWeb.Data
@using LoopCastsWeb.Services
@inject SignInManager<IdentityUser> SignInManager
@inject AppDbContext Db
@* Right side of the nav (loopcasts-ui §4). Keep the name: the Identity UI package looks for "_LoginPartial".
   Desktop: Courses, Pricing, one account button with a menu. Below 720px: one menu icon that opens a sheet with all links. *@
@{
    var page = ViewContext.RouteData.Values["page"] as string;
    var area = ViewContext.RouteData.Values["area"] as string ?? "";
    string? Here(string p, string a = "") => page == p && area == a ? "page" : null;
    string? HereIf(bool on) => on ? "page" : null;
    var inSettings = area == "Identity" && page?.StartsWith("/Account/Manage/") == true;
    var inAdmin = page?.StartsWith("/Admin/") == true;

    var signedIn = SignInManager.IsSignedIn(User);
    var email = User.Identity?.Name ?? "";   // the login name is the e-mail
    var name = signedIn ? await CustomerData.NameAsync(Db, email) : "";
    var first = name.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? name;
    var isAdmin = User.IsInRole(AdminSeeder.AdminRole);
}

<nav class="nav-links" aria-label="Main">
    <a class="nav-link" asp-area="" asp-page="/Courses" aria-current="@Here("/Courses")">Courses</a>
    <a class="nav-link" asp-area="" asp-page="/Pricing" aria-current="@Here("/Pricing")">Pricing</a>
    @if (signedIn)
    {
        <div class="menu" data-menu>
            <button type="button" class="account-btn" aria-expanded="false" aria-controls="account-menu">
                <partial name="_PersonChip" model="name" view-data="@(new ViewDataDictionary(ViewData) { ["Small"] = true })" />
                <span class="account-name">@first</span>
                <svg class="caret" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="2" /></svg>
            </button>
            <div class="menu-panel" id="account-menu">
                <p class="menu-who">Signed in as <strong>@email</strong></p>
                <a class="menu-item" asp-area="" asp-page="/My" aria-current="@Here("/My")">My courses</a>
                <a class="menu-item" asp-area="Identity" asp-page="/Account/Manage/Index" aria-current="@HereIf(inSettings)">Account settings</a>
                @if (isAdmin)
                {
                    <a class="menu-item" asp-area="" asp-page="/Admin/Orders" aria-current="@HereIf(inAdmin)">Admin</a>
                }
                <hr class="menu-sep" />
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                    <button type="submit" class="menu-item">Log out</button>
                </form>
            </div>
        </div>
    }
    else
    {
        <a class="btn-outline btn-small" asp-area="Identity" asp-page="/Account/Login">Log in</a>
    }
</nav>

<div class="menu nav-sheet" data-menu>
    <button type="button" class="icon-btn" aria-expanded="false" aria-controls="sheet-menu" aria-label="Menu">
        <svg class="icon-open" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <svg class="icon-close" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
    </button>
    <div class="menu-panel sheet" id="sheet-menu">
        <a class="menu-item" asp-area="" asp-page="/Courses" aria-current="@Here("/Courses")">Courses</a>
        <a class="menu-item" asp-area="" asp-page="/Pricing" aria-current="@Here("/Pricing")">Pricing</a>
        <hr class="menu-sep" />
        @if (signedIn)
        {
            <p class="menu-who">Signed in as <strong>@email</strong></p>
            <a class="menu-item" asp-area="" asp-page="/My" aria-current="@Here("/My")">My courses</a>
            <a class="menu-item" asp-area="Identity" asp-page="/Account/Manage/Index" aria-current="@HereIf(inSettings)">Account settings</a>
            @if (isAdmin)
            {
                <a class="menu-item" asp-area="" asp-page="/Admin/Orders" aria-current="@HereIf(inAdmin)">Admin</a>
            }
            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                <button type="submit" class="menu-item">Log out</button>
            </form>
        }
        else
        {
            <a class="menu-item" asp-area="Identity" asp-page="/Account/Login">Log in</a>
        }
    </div>
</div>
