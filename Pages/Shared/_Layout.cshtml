<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LoopCasts</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,500;62..125,800&family=Public+Sans:wght@400;600;700&family=Gochi+Hand&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LoopCastsWeb.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        // aria-current="page" on the link of the page you are on (screen readers + the underline in the nav)
        var current = ViewContext.RouteData.Values["page"] as string;
        string? Here(string page) => current == page ? "page" : null;
    }
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
        <div class="container nav-inner">
            <a class="logo" asp-area="" asp-page="/Index" aria-label="LoopCasts home">
                <partial name="_Logo" />
                <span>LoopCasts</span>
            </a>
            <nav class="nav-links" aria-label="Main">
                <a class="nav-link" asp-area="" asp-page="/Courses" aria-current="@Here("/Courses")">Courses</a>
                <a class="nav-link" asp-area="" asp-page="/Pricing" aria-current="@Here("/Pricing")">Pricing</a>
                <partial name="_LoginPartial" />
            </nav>
        </div>
    </header>

    <main id="main" class="container">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container footer-inner">
            <span>&copy; LoopCasts BV, Ghent · <a asp-area="" asp-page="/Privacy">Privacy</a></span>
            <partial name="_SupportLine" />
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
