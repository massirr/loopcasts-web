<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LoopCasts</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,500;62..125,800&family=Public+Sans:wght@400;600;700&family=Gochi+Hand&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LoopCastsWeb.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
        <div class="container nav-inner">
            <a class="logo" asp-area="" asp-page="/Index" aria-label="LoopCasts home">
                <partial name="_Logo" />
                <span>LoopCasts</span>
            </a>
            @* Courses, Pricing, account menu, and the phone menu sheet (loopcasts-ui §4) *@
            <partial name="_LoginPartial" />
        </div>
    </header>

    <main id="main" class="container">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container footer-inner">
            <span class="row"><span>&copy; LoopCasts BV, Ghent</span><a asp-area="" asp-page="/Privacy">Privacy</a></span>
            <partial name="_SupportLine" />
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
