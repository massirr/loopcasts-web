@page
@model OrderThanksModel
@{
    ViewData["Title"] = "Thank you";
    var o = Model.Order!;
    var firstName = o.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? o.Name;
}

<div class="page">
    <partial name="_Progress" model="@(o.IsPaid ? 3 : 2)" />
    <header class="page-head">
        <h1>@(o.IsPaid ? $"Thanks, {firstName}. You're in." : $"Thanks, {firstName}. We're waiting for your payment.")</h1>
        <p>@(o.IsPaid ? "Your invoice and your access are ready. You find both on My courses." : "As soon as your payment arrives, your invoice and your access appear here.")</p>
    </header>

    @* What really happened on the server; site.js only lights the finished steps up one by one *@
    <ol class="steps" data-sequence aria-label="What happened">
        <li class="step @(o.IsPaid ? "on" : "off")">
            <b>Paid</b>
            <span>@(o.IsPaid ? $"€{(Model.Invoice?.Total ?? o.Price):0.00}, {Model.Plan?.Name ?? o.PlanCode}" : "waiting")</span>
        </li>
        <li class="step @(Model.Invoice is null ? "off" : "on")">
            <b>Invoice</b>
            <span class="num">@(Model.Invoice?.Number ?? "after payment")</span>
        </li>
        <li class="step @(Model.Account is null ? "off" : "on")">
            <b>Account</b>
            <span>@(Model.Account is null ? "after payment" : Model.Account.EndsOn is { } end ? $"until {end:dd/MM/yyyy}" : "lifetime access")</span>
        </li>
        <li class="step @(Model.EmailSent ? "on" : "off")">
            <b>E-mail</b>
            <span>@(Model.EmailSent ? "sent to you" : "not set up yet")</span>
        </li>
    </ol>

    <div class="thanks-grid">
        <section class="card" aria-labelledby="order-title">
            <h2 id="order-title" class="h-small">Order @o.Id</h2>
            <dl class="facts">
                <dt>Product</dt><dd>@(Model.Plan?.Name ?? o.PlanCode)</dd>
                <dt>Price</dt><dd>@($"€{o.Price:0.00}") excl. VAT</dd>
                @if (!string.IsNullOrWhiteSpace(o.Company))
                {
                    <dt>Company</dt><dd>@o.Company (@o.VatNumber)</dd>
                }
                <dt>E-mail</dt><dd>@o.Email</dd>
                <dt>Ordered</dt><dd>@o.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
                @if (Model.Invoice is { } inv)
                {
                    <dt>Invoice</dt>
                    <dd>
                        <span class="num">@inv.Number</span><br />
                        @($"€{inv.Total:0.00}") incl. @($"{inv.VatRate * 100:0}")% VAT
                        @if (inv.ReverseCharge) { <br /><span class="muted small">VAT reverse charged</span> }
                    </dd>
                }
            </dl>
        </section>

        @if (Model.PasswordSetupUrl is not null)
        {
            <section class="card" aria-labelledby="login-title">
                <h2 id="login-title" class="h-small">Your login is ready</h2>
                <p>Log in with <strong class="wrap-any">@o.Email</strong>. Choose your password first; the link works for 24 hours.</p>
                <div><a class="btn-sign" href="@Model.PasswordSetupUrl">Set your password</a></div>
            </section>
        }
        else if (Model.HasLogin)
        {
            <section class="card">
                <h2 class="h-small">Start watching</h2>
                <p><a asp-area="Identity" asp-page="/Account/Login">Log in</a> with @o.Email to see your courses.</p>
            </section>
        }
    </div>
</div>
