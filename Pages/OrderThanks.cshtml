@page
@model OrderThanksModel
@{
    ViewData["Title"] = "Thank you";
    var o = Model.Order!;
}

<h1 class="mb-1">Thank you, @o.Name</h1>
<p class="text-muted mb-4">Your order is saved. Nobody had to retype anything.</p>

<div class="card" style="max-width:560px">
    <div class="card-body">
        <h2 class="h5">Order #@o.Id</h2>
        <dl class="row mb-0">
            <dt class="col-sm-4">Product</dt><dd class="col-sm-8">@(Model.Plan?.Name ?? o.PlanCode)</dd>
            <dt class="col-sm-4">Price</dt><dd class="col-sm-8">@($"€{o.Price:0.00}") excl. VAT</dd>
            @if (!string.IsNullOrWhiteSpace(o.Company))
            {
                <dt class="col-sm-4">Company</dt><dd class="col-sm-8">@o.Company (@o.VatNumber)</dd>
            }
            <dt class="col-sm-4">E-mail</dt><dd class="col-sm-8">@o.Email</dd>
            <dt class="col-sm-4">Ordered</dt><dd class="col-sm-8">@o.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
            <dt class="col-sm-4">Status</dt><dd class="col-sm-8">@(o.IsPaid ? "Paid" : "Waiting for payment")</dd>
            @if (Model.Invoice is { } inv)
            {
                <dt class="col-sm-4">Invoice</dt>
                <dd class="col-sm-8">
                    @inv.Number · @($"€{inv.Total:0.00}") incl. @($"{inv.VatRate * 100:0}")% VAT
                    @if (inv.ReverseCharge) { <span class="badge text-bg-secondary">VAT reverse charged</span> }
                </dd>
            }
            @if (Model.Account is { } acc)
            {
                <dt class="col-sm-4">Access</dt>
                <dd class="col-sm-8">@(acc.EndsOn is { } end ? $"until {end:dd/MM/yyyy}" : "lifetime")</dd>
            }
        </dl>
    </div>
</div>

@if (Model.PasswordSetupUrl is not null)
{
    <div class="alert alert-success mt-4" style="max-width:560px">
        <h2 class="h5">Your LoopCasts login is ready</h2>
        <p class="mb-2">Log in with <strong>@o.Email</strong>. Choose your password first (link valid for 24 hours):</p>
        <a class="btn btn-success" href="@Model.PasswordSetupUrl">Set your password</a>
    </div>
}
else if (Model.HasLogin)
{
    <p class="mt-4">You can <a asp-area="Identity" asp-page="/Account/Login">log in</a> with @o.Email to see your courses.</p>
}
