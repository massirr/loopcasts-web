@page
@model CoursesModel
@{
    ViewData["Title"] = "Courses";
}

<div class="page">
    <header class="section-head">
        <div class="page-head">
            <h1>Courses</h1>
            <p>@Model.Courses.Count courses you can watch today. Buy one for @($"€{Model.SinglePrice:0}"), or get all of them with a subscription.</p>
        </div>
        <a class="btn-sign" asp-page="/Pricing">See plans</a>
    </header>

    @foreach (var level in Model.Courses.GroupBy(c => c.Level))
    {
        <section class="section" aria-labelledby="level-@level.Key">
            <h2 id="level-@level.Key">@level.Key <span class="muted small num">@level.Count()</span></h2>
            <div class="course-grid">
                @foreach (var course in level)
                {
                    <partial name="_CourseCard" model="course" />
                }
            </div>
        </section>
    }
</div>
