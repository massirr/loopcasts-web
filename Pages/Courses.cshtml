@page
@model CoursesModel
@{
    ViewData["Title"] = "Courses";
}

<h1 class="mb-1">Courses</h1>
<p class="text-muted mb-4">@Model.Courses.Count courses available, loaded live from the database.</p>

@foreach (var level in Model.Courses.GroupBy(c => c.Level))
{
    <h2 class="h4 mt-4">@level.Key</h2>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
        @foreach (var course in level)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <h3 class="h6 card-title">@course.Title</h3>
                        <p class="card-text small text-muted mb-0">
                            @(course.VideoCount?.ToString() ?? "–") videos
                            · @CoursesModel.FormatDuration(course.DurationMinutes)
                        </p>
                    </div>
                    <div class="card-footer bg-transparent d-flex justify-content-between align-items-center">
                        <span>@(course.Price is null ? "–" : $"€{course.Price:0}")</span>
                        <a class="btn btn-sm btn-outline-primary" asp-page="/Order" asp-route-plan="single">Order</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
