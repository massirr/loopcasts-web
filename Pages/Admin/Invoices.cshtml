@page
@model LoopCastsWeb.Pages.Admin.InvoicesModel
@{
    ViewData["Title"] = "Invoices & accounts";
    var thisMonth = Model.Invoices.Where(i => i.IssuedOn.Year == DateTime.Today.Year && i.IssuedOn.Month == DateTime.Today.Month).ToList();
    var today = DateOnly.FromDateTime(DateTime.Today);
}

<div class="page admin">
    <partial name="_AdminNav" />

    <section class="section" aria-labelledby="inv-title">
        <header class="page-head">
            <h1 id="inv-title">Invoices</h1>
            <p class="num">Revenue this month excl. VAT: <strong>@($"€{thisMonth.Sum(i => i.AmountExclVat):0.00}")</strong> · @thisMonth.Count invoices · calculated, not summed by colour</p>
        </header>
        <div class="table-scroll">
            <table class="table table-dense">
                <thead><tr><th>Number</th><th>Date</th><th>Customer</th><th class="end">Excl.</th><th class="end">VAT</th><th class="end">Total</th><th><span class="visually-hidden">Note</span></th></tr></thead>
                <tbody>
                    @foreach (var i in Model.Invoices)
                    {
                        <tr>
                            <td><a asp-page="/Invoice" asp-route-number="@i.Number"><strong>@i.Number</strong></a></td>
                            <td>@i.IssuedOn.ToString("dd/MM/yyyy")</td>
                            <td class="wrap-any">@(i.BillingCompany ?? i.BillingName) <span class="muted small">@i.BillingCountry</span></td>
                            <td class="end">@($"€{i.AmountExclVat:0.00}")</td>
                            <td class="end">@($"€{i.VatAmount:0.00}") <span class="muted small">(@($"{i.VatRate * 100:0}")%)</span></td>
                            <td class="end">@($"€{i.Total:0.00}")</td>
                            <td>@if (i.ReverseCharge) { <span class="muted small">reverse charge</span> }</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="section" aria-labelledby="acc-title">
        <div class="section-head">
            <h2 id="acc-title">Accounts</h2>
            <form method="post" asp-page-handler="RunExpiry">
                <button type="submit" class="btn-outline btn-small">Run expiry check now</button>
            </form>
        </div>
        @if (Model.Message is not null)
        {
            <p class="flash flash-info" role="status"><span>@Model.Message</span></p>
        }
        <div class="table-scroll">
            <table class="table table-dense">
                <thead><tr><th>E-mail</th><th>Order</th><th>Start</th><th>Ends</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var a in Model.Accounts)
                    {
                        var expired = a.EndsOn is { } end && end < today;
                        <tr>
                            <td class="wrap-any">@a.Email</td>
                            <td>#@a.OrderId</td>
                            <td>@a.StartsOn.ToString("dd/MM/yyyy")</td>
                            <td>@(a.EndsOn?.ToString("dd/MM/yyyy") ?? "lifetime")</td>
                            <td>
                                @if (!a.IsActive) { <span class="status status-off">Inactive</span> }
                                else if (expired) { <span class="status status-error">Active but expired!</span> }
                                else { <span class="status status-ok">Active</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
