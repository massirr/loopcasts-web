@page
@model PricingModel
@{
    ViewData["Title"] = "Pricing";
    static string Per(Plan p) => p.AccessMonths switch { 1 => "per month", 12 => "per year", null => "once, yours to keep", _ => $"per {p.AccessMonths} months" };
}

<div class="page">
    <header class="page-head">
        <h1>Pricing</h1>
        <p>All prices excl. VAT. You see the total with VAT before you pay.</p>
    </header>

    <div class="plans">
        @foreach (var plan in Model.Plans)
        {
            <article class="card plan">
                <h2>@plan.Name</h2>
                <p class="price num">@($"€{plan.Price:0}") <span class="muted small">@Per(plan)</span></p>
                <p class="muted">@plan.Detail</p>
                @if (plan.Seats > 1)
                {
                    <p class="small"><strong>@plan.Seats seats</strong>, for companies</p>
                }
                @* Before: a mailto: link. Now: our own order form, with the plan already chosen. *@
                <a class="btn-sign btn-wide" asp-page="/Order" asp-route-plan="@plan.Code" aria-label="Order @plan.Name">Order</a>
            </article>
        }
    </div>
</div>
