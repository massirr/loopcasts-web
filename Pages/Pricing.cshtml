@page
@model PricingModel
@{
    ViewData["Title"] = "Pricing";
}

<h1 class="mb-1">Pricing</h1>
<p class="text-muted mb-4">All prices excl. VAT.</p>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-3">
    @foreach (var plan in Model.Plans)
    {
        <div class="col">
            <div class="card h-100 text-center">
                <div class="card-body">
                    <h2 class="h5">@plan.Name</h2>
                    <p class="display-6 my-3">@($"€{plan.Price:0}")</p>
                    <p class="small text-muted">@plan.Detail</p>
                </div>
                <div class="card-footer bg-transparent">
                    @* Before: a mailto: link. Now: our own order form, with the plan already chosen. *@
                    <a class="btn btn-primary w-100" asp-page="/Order" asp-route-plan="@plan.Code">Order</a>
                </div>
            </div>
        </div>
    }
</div>
